# Server
NODE_ENV=development
PORT=3000

# Database (Supabase — replace with real values)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres

# Clerk (JWT verification)
CLERK_PUBLISHABLE_KEY=pk_test_d2VsbC1raXdpLTk2LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_5xeIgpBA9KSp4dO5ITe9RgvLsMIZkohu3InJfSiDsb

# CORS (iOS-only now; no browser clients)
ALLOWED_ORIGINS=*

# Engine thresholds
OFF_ROUTE_THRESHOLD_METERS=75
SPLIT_THRESHOLD_METERS=5000

# Google Play subscription verification.
# Service-account JSON from a GCP project with the Google Play Android Developer
# API enabled, and that service account granted access in Play Console under
# Users & Permissions. Accepts raw JSON or base64 — prefer base64 in dashboards
# that mangle the newlines in the PEM private key.
# Until this is set, POST /memberships/activate answers Play purchases with
# 502 PLAY_VERIFICATION_UNAVAILABLE; the Apple path is unaffected.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=com.danglingmind.convotrack

# App-level free trial: "true" blocks create/join for free riders whose 3 days are over
TRIAL_ENFORCEMENT_ENABLED=false

# Product analytics (PostHog). Leave POSTHOG_API_KEY empty to send nothing.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
